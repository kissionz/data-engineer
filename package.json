{
  "name": "montane-code",
  "version": "0.3.0",
  "description": "A security-first local coding agent runtime for durable, verifiable software work.",
  "license": "UNLICENSED",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/kissionz/data-engineer.git"
  },
  "homepage": "https://github.com/kissionz/data-engineer#readme",
  "bugs": {
    "url": "https://github.com/kissionz/data-engineer/issues"
  },
  "type": "module",
  "types": "./dist/sdk.d.ts",
  "exports": {
    ".": {
      "types": "./dist/sdk.d.ts",
      "import": "./dist/sdk.js"
    }
  },
  "bin": {
    "montane": "./dist/index.js",
    "montane-worktrees": "./dist/cli/worktreeReport.js",
    "montane-telemetry-report": "./dist/cli/telemetryReport.js",
    "harness": "./dist/index.js",
    "harness-worktrees": "./dist/cli/worktreeReport.js",
    "harness-telemetry-report": "./dist/cli/telemetryReport.js"
  },
  "files": [
    "dist",
    "README.md",
    ".env.example",
    "config.example.json",
    "LICENSE"
  ],
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "tsx src/index.ts",
    "build": "tsc",
    "prepack": "npm run build",
    "start": "node dist/index.js",
    "worktrees": "node dist/cli/worktreeReport.js",
    "telemetry:report": "node dist/cli/telemetryReport.js",
    "test": "vitest",
    "test:coverage": "vitest run --coverage",
    "test:integration:docker": "vitest run tests/dockerIntegration.test.ts",
    "test:acceptance": "vitest run tests/acceptance.test.ts",
    "test:contract": "vitest run tests/openai.test.ts tests/mcp.test.ts",
    "lint": "eslint src tests eslint.config.js vitest.config.ts --max-warnings=0",
    "check": "npm run lint && npm run build && npm test -- --run && npm run test:coverage",
    "eval": "npm run build --silent && node dist/eval/cli.js",
    "eval:live": "npm run build --silent && node dist/eval/liveCli.js",
    "pack:check": "npm pack --dry-run"
  },
  "keywords": [
    "coding-agent",
    "developer-tools",
    "mcp",
    "openai",
    "sandbox"
  ],
  "dependencies": {
    "@inquirer/prompts": "^7.0.0",
    "@modelcontextprotocol/sdk": "1.29.0",
    "ajv": "8.18.0",
    "commander": "^13.0.0",
    "undici": "7.28.0",
    "yaml": "^2.9.0",
    "zod": "4.1.12"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.4",
    "@types/node": "^22.0.0",
    "@vitest/coverage-v8": "^4.1.9",
    "eslint": "^9.39.4",
    "tsx": "^4.19.0",
    "typescript": "^5.7.0",
    "typescript-eslint": "^8.62.1",
    "vitest": "^4.1.9"
  }
}
