OPENAI_API_KEY=sk-your-key
MONTANE_MODEL=gpt-4.1
OPENAI_BASE_URL=https://api.openai.com/v1
MONTANE_PROVIDER=openai

# Native providers:
# ANTHROPIC_API_KEY=your-anthropic-key
# ANTHROPIC_BASE_URL=https://api.anthropic.com/v1
# GEMINI_API_KEY=your-gemini-key
# GEMINI_BASE_URL=https://generativelanguage.googleapis.com/v1beta
# MONTANE_MODEL=provider-specific-model-name

# API style: "responses" for OpenAI native, "chat_completions" for compatible APIs (DeepSeek, etc.)
# Auto-detected based on base URL if not set (non-OpenAI URLs default to chat_completions)
# OPENAI_API_STYLE=chat_completions

# Bash is sandboxed with Docker when available. It never falls back to host.
MONTANE_BASH_SANDBOX=auto
MONTANE_SANDBOX_IMAGE=node:22-bookworm
MONTANE_SANDBOX_PULL=never
MONTANE_SANDBOX_NETWORK=none

# Legacy HARNESS_* names remain supported during the 0.x series.

# Optional: official MaxCompute Local MCP over a regional VPC endpoint.
# MAXCOMPUTE_ENDPOINT=https://service.cn-shanghai-vpc.maxcompute.aliyun-inc.com/api
# MAXCOMPUTE_DEFAULT_PROJECT=your_project
# MAXCOMPUTE_NAMESPACE_ID=your_root_account_uid
# ALIBABA_CLOUD_ACCESS_KEY_ID=your_access_key_id
# ALIBABA_CLOUD_ACCESS_KEY_SECRET=your_access_key_secret
# ALIBABA_CLOUD_SECURITY_TOKEN=your_sts_token
# ALIBABA_CLOUD_CREDENTIALS_URI=http://trusted-host/credentials
